{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@slate/storage/tidy-batch": ["packages/storage/src/tidyBatch.ts"],
      "@slate/ui/native": ["packages/ui/src/native/NativeApp.tsx"],
      "@slate/storage/tauri-workspace-index": ["packages/storage/src/tauriWorkspaceIndex.ts"],
      "@slate/storage/tauri-files": ["packages/storage/src/tauriFiles.ts"],
      "@slate/storage/file-io": ["packages/storage/src/fileIO.ts"],
      "@slate/storage/file-space": ["packages/storage/src/fileSpace.ts"],
      "@slate/core": ["packages/core/src/index.ts"],
      "@slate/core/tidy/settings": ["packages/core/src/tidy/settings.ts"],
      "@slate/core/tidy": ["packages/core/src/tidy/index.ts"],
      "@slate/export": ["packages/export/src/index.ts"],
      "@slate/publish": ["packages/publish/src/index.ts"],
      "@slate/storage": ["packages/storage/src/index.ts"],
      "@slate/storage/browser-tidy": ["packages/storage/src/browserTidy.ts"],
      "@slate/storage/browser-files": ["packages/storage/src/browserFiles.ts"],
      "@slate/storage/browser-import": ["packages/storage/src/browserImport.ts"],
      "@slate/storage/browser-space": ["packages/storage/src/browserSpace.ts"],
      "@slate/storage/browser-archive": ["packages/storage/src/browserArchive.ts"],
      "@slate/storage/browser-catalog": ["packages/storage/src/browserCatalog.ts"],
      "@slate/storage/browser-ownership": ["packages/storage/src/browserOwnership.ts"],
      "@slate/storage/web-opfs": ["packages/storage/src/webOpfsSqlite.ts"],
      "@slate/storage/runtime": ["packages/storage/src/runtimeSqliteAdapter.ts"],
      "@slate/sync": ["packages/sync/src/index.ts"],
      "@slate/editor": ["packages/editor/src/index.ts"],
      "@slate/ui": ["packages/ui/src/index.ts"],
      "@slate/ui/browser": ["packages/ui/src/browser/BrowserApp.tsx"],
      "@slate/tokens": ["packages/tokens/src/index.ts"]
    }
  }
}
