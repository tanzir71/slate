{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:web": "pnpm --filter @slate/web dev",
    "dev:desktop": "pnpm --filter @slate/desktop dev",
    "typecheck": "pnpm -r --if-present typecheck && cargo check --manifest-path crates/slate-core/Cargo.toml",
    "lint": "eslint . --max-warnings 0 && cargo clippy --manifest-path crates/slate-core/Cargo.toml -- -D warnings",
    "test": "vitest run --coverage && cargo test --manifest-path crates/slate-core/Cargo.toml",
    "e2e": "playwright test",
    "build": "pnpm -r --if-present build && pnpm --filter @slate/desktop tauri:build",
    "perf": "node scripts/perf-budgets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm perf && pnpm e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
