{
  "name": "slate",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:web": "pnpm --filter @slate/web dev",
    "dev:desktop": "pnpm --filter @slate/desktop dev",
    "typecheck": "pnpm -r --if-present typecheck && cargo check --manifest-path crates/slate-core/Cargo.toml",
    "lint": "eslint . --max-warnings 0 && pnpm lint:design && cargo clippy --manifest-path crates/slate-core/Cargo.toml -- -D warnings",
    "lint:design": "stylelint \"packages/ui/src/**/*.css\" \"docs/landing.css\" --max-warnings 0 && node scripts/check-design.mjs",
    "test": "vitest run --coverage && cargo test --manifest-path crates/slate-core/Cargo.toml && node --test scripts/test/*.test.mjs",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --config=playwright.desktop.config.ts",
    "visual": "node scripts/visual-test.mjs",
    "build": "pnpm -r --if-present build && pnpm --filter @slate/desktop tauri:build",
    "build:site": "node scripts/build-site.mjs && node scripts/verify-site.mjs",
    "shots": "node scripts/shots.mjs",
    "perf:site": "node scripts/perf-site.mjs",
    "perf": "node scripts/perf-budgets.mjs",
    "perf:typing": "playwright test --config=playwright.performance.config.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:site && pnpm perf:site && pnpm perf && pnpm e2e:desktop && pnpm e2e && pnpm visual && pnpm perf:typing",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "jsdom": "^26.1.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
