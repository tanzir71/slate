{
  "name": "@slate/storage",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tauri-sql": {
      "types": "./dist/tauriSql.d.ts",
      "import": "./dist/tauriSql.js"
    },
    "./web-opfs": {
      "types": "./dist/webOpfsSqlite.d.ts",
      "import": "./dist/webOpfsSqlite.js"
    },
    "./runtime": {
      "types": "./dist/runtimeSqliteAdapter.d.ts",
      "import": "./dist/runtimeSqliteAdapter.js"
    },
    "./web-file-source": {
      "types": "./dist/webFileSource.d.ts",
      "import": "./dist/webFileSource.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slate/core": "workspace:*",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "wa-sqlite": "^1.0.0"
  }
}
