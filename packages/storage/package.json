{
  "name": "@slate/storage",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    "./browser-import": {
      "types": "./dist/browserImport.d.ts",
      "import": "./dist/browserImport.js"
    },
    "./browser-files": {
      "types": "./dist/browserFiles.d.ts",
      "import": "./dist/browserFiles.js"
    },
    "./browser-space": {
      "types": "./dist/browserSpace.d.ts",
      "import": "./dist/browserSpace.js"
    },
    "./browser-archive": {
      "types": "./dist/browserArchive.d.ts",
      "import": "./dist/browserArchive.js"
    },
    "./browser-catalog": {
      "types": "./dist/browserCatalog.d.ts",
      "import": "./dist/browserCatalog.js"
    },
    "./browser-ownership": {
      "types": "./dist/browserOwnership.d.ts",
      "import": "./dist/browserOwnership.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tauri-sql": {
      "types": "./dist/tauriSql.d.ts",
      "import": "./dist/tauriSql.js"
    },
    "./web-opfs": {
      "types": "./dist/webOpfsSqlite.d.ts",
      "import": "./dist/webOpfsSqlite.js"
    },
    "./runtime": {
      "types": "./dist/runtimeSqliteAdapter.d.ts",
      "import": "./dist/runtimeSqliteAdapter.js"
    },
    "./web-file-source": {
      "types": "./dist/webFileSource.d.ts",
      "import": "./dist/webFileSource.js"
    },
    "./tauri-file-source": {
      "types": "./dist/tauriFileSource.d.ts",
      "import": "./dist/tauriFileSource.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slate/core": "workspace:*",
    "@tauri-apps/api": "^2.10.2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "fflate": "^0.8.3",
    "@journeyapps/wa-sqlite": "2.0.10"
  }
}
