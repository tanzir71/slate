{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Slate desktop permissions",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "allow-pending-native-launches",
    "allow-bind-native-launch",
    "allow-begin-native-launch",
    "allow-apply-native-launch",
    "allow-review-native-launch",
    "allow-complete-native-launch",
    "allow-next-native-launch",
    "allow-list-native-spaces",
    "allow-pick-native-space",
    "allow-write-sheet",
    "allow-write-numbered-asset",
    "allow-list-markdown-files",
    "allow-read-markdown-file",
    "allow-read-tidy-settings",
    "allow-write-tidy-settings",
    "allow-list-workspace-files",
    "allow-read-workspace-file",
    "allow-read-workspace-file-info",
    "allow-reveal-workspace-file",
    "allow-create-workspace-file",
    "allow-save-workspace-file",
    "allow-move-workspace-file",
    "allow-trash-workspace-file",
    "allow-workspace-watch-status",
    "allow-replace-workspace-index",
    "allow-search-workspace-index"
  ]
}
