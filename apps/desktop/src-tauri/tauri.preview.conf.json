{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate Preview",
  "identifier": "com.slate.workspace.preview",
  "plugins": { "deep-link": { "desktop": { "schemes": ["slate-preview"] } } },
  "bundle": {
    "active": true,
    "fileAssociations": [{ "ext": ["md"], "name": "SlatePreview.Markdown", "description": "Markdown document", "mimeType": "text/markdown", "role": "Editor", "rank": "Alternate" }],
    "createUpdaterArtifacts": false,
    "shortDescription": "Unsigned Slate desktop preview",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
