{
  "name": "Slate — your words, your files",
  "short_name": "Slate",
  "description": "An offline Markdown workspace. No account, no server. Your files stay yours.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#f6f6f4",
  "icons": [
    { "src": "./brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New sheet", "url": "./?action=new" },
    { "name": "Today", "url": "./?action=today" },
    { "name": "Capture", "url": "./?action=capture" }
  ],
  "file_handlers": [{ "action": "./?action=open", "accept": { "text/markdown": [".md"] } }],
  "share_target": { "action": "./?action=capture", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "launch_handler": { "client_mode": "focus-existing" }
}
